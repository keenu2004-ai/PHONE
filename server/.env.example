# =======================================================
# TeamNest Express Backend Environment Variables Template
# =======================================================

# Database Connection String (PostgreSQL or SQLite)
# PostgreSQL Example: postgresql://user:password@host:5432/teamnest_db?schema=public
# SQLite Local Example: file:./dev.db
DATABASE_URL="file:./dev.db"

# JWT Auth Secret for Session Signing
JWT_SECRET="teamnest_super_secret_production_jwt_signing_key_2026"

# Cloud Storage Bucket URL for Receipt Image Uploads (S3 / Supabase Storage)
STORAGE_BUCKET_URL="https://your-bucket-name.s3.us-east-1.amazonaws.com/receipts"

# Server Port
PORT=5000

# Node Environment (development | production)
NODE_ENV="production"
